rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'majedhossain3000@gmail.com' ||
        request.auth.uid == 'kpEuIe77YrbXAhUeh6Uer6gbnGE2'
      );
    }

    // Site settings
    match /settings/site {
      allow read: if true;
      allow write: if isAdmin();
    }

    // About info
    match /about/main {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact and social links
    match /contact/main {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Activities
    match /activities/{activityId} {
      allow read: if (resource == null || resource.data.published == true) || isAdmin();
      allow write: if isAdmin();
    }

    // Gallery
    match /gallery/{galleryId} {
      allow read: if (resource == null || resource.data.published == true) || isAdmin();
      allow write: if isAdmin();
    }

    // Initiatives
    match /initiatives/{initiativeId} {
      allow read: if (resource == null || resource.data.published == true) || isAdmin();
      allow write: if isAdmin();
    }

    // Notice Board
    match /notices/{noticeId} {
      allow read: if (resource == null || resource.data.published == true) || isAdmin();
      allow write: if isAdmin();
    }

    // Public submissions (Contact, Member application, Volunteer application, Support request)
    match /submissions/{submissionId} {
      // Public can create new submissions with status 'new' and reasonable string boundaries
      allow create: if request.resource.data.type in ['member_application', 'volunteer_application', 'support_request', 'contact']
        && request.resource.data.status == 'new'
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() <= 3000;
      
      // Only authorized administrator can read, update (e.g. status or notes), or delete submissions
      allow read, update, delete: if isAdmin();
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
